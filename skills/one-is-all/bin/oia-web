    "open": ("待批复", "wait"),
    "submitted": ("已提交，等主控", "review"),
    "answered": ("主控已回", "run"),
    "approved": ("已批准", "run"),
    "rejected": ("已驳回", "block"),
    "questioned": ("已提问", "wait"),
}
ROLE = {"worker": "成员", "leader": "主控", "user": "你"}
KIND = {
    "plan": "方案", "step": "步骤", "report": "完成报告", "verdict": "裁决",
    "question": "提问", "answer": "回答", "note": "备注",
}
DECISION = {"approve": "批准", "reject": "驳回", "question": "提问"}

